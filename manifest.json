{
  "manifest_version": 3,
  "name": "GitHub 国内加速器",
  "version": "1.2.0",
  "description": "进入 GitHub 自动加速：raw / Releases / Archive / codeload / gist 请求自动重定向到自选线路；自动模式（有 GitHub 页面才加速）、测速、下载测速、流量/时长统计、动态图标、自定义线路。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "declarativeNetRequest", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub 加速器（点击选择线路）",
    "default_icon": {
      "16": "icons/icon-dark-16.png",
      "32": "icons/icon-dark-32.png",
      "48": "icons/icon-dark-48.png",
      "128": "icons/icon-dark-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-green-16.png",
    "32": "icons/icon-green-32.png",
    "48": "icons/icon-green-48.png",
    "128": "icons/icon-green-128.png"
  }
}
